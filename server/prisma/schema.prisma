generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  bank
  wallet
  card
  invest
}

enum TransactionType {
  income
  expense
  transfer
  debt_repay
  tax_event
}

enum CategoryType {
  income
  expense
}

enum AssetClass {
  stock
  mf
  crypto
  gold
  property
}

enum TradeAction {
  buy
  sell
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  baseCurrency  String    @default("INR")
  taxJurisdiction String  @default("IN")
  fyStart       Int       @default(4) // Indian FY starts April
  createdAt     DateTime  @default(now())

  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  assets        Asset[]
  loans         Loan[]
  deductions    Deduction[]
}

model Account {
  id            String      @id @default(cuid())
  userId        String
  type          AccountType
  name          String
  openingBalance Float       @default(0)
  currency      String      @default("INR")
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[] @relation("txnFromAccount")
  transfersFrom Transaction[] @relation("txnToAccount")

  @@index([userId])
}

model Category {
  id        String       @id @default(cuid())
  userId    String?
  name      String
  type      CategoryType
  isCustom  Boolean      @default(false)

  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  accountId   String
  toAccountId String?
  type        TransactionType
  categoryId  String?
  amount      Float
  date        DateTime
  note        String?
  tags        String          @default("[]") // JSON array of strings
  createdAt   DateTime        @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account         @relation("txnFromAccount", fields: [accountId], references: [id])
  toAccount   Account?        @relation("txnToAccount", fields: [toAccountId], references: [id])
  category    Category?       @relation(fields: [categoryId], references: [id])

  @@index([userId, date])
  @@index([userId, accountId])
}

model Asset {
  id     String    @id @default(cuid())
  userId String
  symbol String
  name   String
  class  AssetClass
  price  Float     @default(0) // latest manual price
  priceUpdatedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lots    Lot[]
  trades  Trade[]

  @@index([userId])
}

model Lot {
  id        String   @id @default(cuid())
  assetId   String
  qty       Float
  unitPrice Float
  fees      Float    @default(0)
  date      DateTime
  remainingQty Float // decremented on FIFO sells

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, date])
}

model Trade {
  id        String     @id @default(cuid())
  assetId   String
  action    TradeAction
  qty       Float
  unitPrice Float
  fees      Float      @default(0)
  date      DateTime
  realizedGain Float?  // set on sells (negative = loss)
  holdingPeriodDays Int? // realized gain holding days (legacy, earliest-lot)
  gainSplit Json?      // per-lot slices [{holdingPeriodDays, gain}] on sells

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, date])
}

model Loan {
  id           String   @id @default(cuid())
  userId       String
  name         String
  principal    Float
  interestRate Float // annual %
  startDate    DateTime
  tenureMonths Int
  emi          Float?   // derived if null, stored once computed

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Deduction {
  id      String   @id @default(cuid())
  userId  String
  fyKey   String // e.g. "2026-27"
  section String // 80C | 80D | ...
  amount  Float
  note    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, fyKey])
}